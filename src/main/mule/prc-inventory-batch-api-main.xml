<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="${http.port}"/>
    </http:listener-config>

    <flow name="prc-inventory-batch-api-schedular-flow">

        <scheduler doc:name="Scheduler — daily 4 AM" doc:id="773a1fc8-c0c8-46a7-bc3b-51c4e5714078" disallowConcurrentExecution="true">
            <scheduling-strategy>
                <cron expression="${scheduler.cron}" timeZone="${scheduler.timezone}"/>
            </scheduling-strategy>
        </scheduler>

        <logger level="INFO" doc:name="Log Scheduled Start"
                message="Started scheduled inventory batch execution"/>

        <flow-ref name="inventory-batch-job-sub-flow" doc:name="Execute Inventory Batch Job"/>

        <logger level="INFO" doc:name="Log Scheduled Completion"
                message="Completed scheduled inventory batch execution"/>

        <error-handler ref="global-error-handlingError_Handler"/>
    </flow>

    <flow name="manual-inventory-batch-trigger-flow">

        <http:listener
            config-ref="HTTP_Listener_config"
            path="/inventory/batch/run"
            allowedMethods="POST"
            doc:name="Manual Inventory Batch POST">
            <http:response statusCode="#[vars.httpStatus default 202]"/>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
            </http:error-response>
        </http:listener>

        <logger level="INFO" doc:name="Log Manual Trigger"
                message="Manual inventory batch execution requested"/>

        <ee:transform doc:name="Validate Request">
            <ee:variables>
                <ee:set-variable variableName="validationErrors"><![CDATA[
%dw 2.0
output application/java

var body        = if (payload is Object) payload else {}
var fileName    = if (body.fileName is String) trim(body.fileName) else ""
var filePath    = if (body.filePath is String) trim(body.filePath) else ""
var allowedBase = p('inventory.manual.allowedBasePath') default ""
---
[
    if (!(payload is Object))
        "Request body must be a JSON object"
    else null,

    if (isEmpty(fileName))
        "fileName is required"
    else if (sizeOf(fileName) > 255)
        "fileName must be 255 characters or fewer"
    else if (!(fileName matches /^[A-Za-z0-9._-]+$/))
        "fileName may only contain letters, digits, '.', '_' and '-'"
    else if (fileName contains "..")
        "fileName must not contain '..'"
    else null,

    if (isEmpty(filePath))
        "filePath is required"
    else if (!(filePath matches /^\/[A-Za-z0-9._\/-]*$/))
        "filePath must be an absolute path (start with '/') using letters, digits, '.', '_', '-' and '/'"
    else if (filePath contains "..")
        "filePath must not contain '..'"
    else if (!isEmpty(allowedBase) and !(filePath startsWith allowedBase))
        "filePath must be under " ++ allowedBase
    else null
] filter ($ != null)
                ]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <choice doc:name="Is Request Valid?">

            <when expression="#[!isEmpty(vars.validationErrors)]">
                <set-variable variableName="httpStatus" value="#[400]" doc:name="Set 400"/>
                <logger level="WARN" doc:name="Log Validation Failure"
                        message="#['Manual trigger rejected: ' ++ write(vars.validationErrors, 'application/json')]"/>
                <ee:transform doc:name="Build 400 Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "REJECTED",
    message: "Request validation failed",
    errors: vars.validationErrors,
    traceId: correlationId
}
                        ]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </when>

            <otherwise>
                <ee:transform doc:name="Capture Request Inputs">
                    <ee:variables>
                        <ee:set-variable variableName="inputFileName"><![CDATA[
%dw 2.0
output application/java
---
trim(payload.fileName)
                        ]]></ee:set-variable>
                        <ee:set-variable variableName="inputFilePath"><![CDATA[
%dw 2.0
output application/java
var path = trim(payload.filePath)
---
if (sizeOf(path) > 1 and (path endsWith "/")) path[0 to -2] else path
                        ]]></ee:set-variable>
                        <ee:set-variable variableName="traceId"><![CDATA[
%dw 2.0
output application/java
---
correlationId
                        ]]></ee:set-variable>
                    </ee:variables>
                </ee:transform>

                <async doc:name="Run Job in Background" maxConcurrency="1">
                    <flow-ref name="inventory-batch-job-async-sub-flow"
                              doc:name="Execute Inventory Batch Job"/>
                </async>

                <ee:transform doc:name="Build 202 Response">
                    <ee:message>
                        <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "ACCEPTED",
    message: "Inventory batch job started. You will be notified via email once it is completed.",
    traceId: vars.traceId,
    fileName: vars.inputFileName,
    filePath: vars.inputFilePath,
    submittedAt: now()
}
                        ]]></ee:set-payload>
                    </ee:message>
                </ee:transform>
            </otherwise>
        </choice>

        <error-handler ref="global-error-handlingError_Handler"/>
    </flow>

    <sub-flow name="inventory-batch-job-async-sub-flow">
        <try doc:name="Try Job">
            <flow-ref name="inventory-batch-job-sub-flow" doc:name="Execute Inventory Batch Job"/>
            <error-handler>
                <on-error-continue doc:name="On Job Failure">
                    <logger level="ERROR" doc:name="Log Async Failure"
                            message="#['Manual inventory batch failed. traceId=' ++ (vars.traceId default '') ++ ' error=' ++ (error.description default '')]"/>
                </on-error-continue>
            </error-handler>
        </try>
    </sub-flow>

    <sub-flow name="inventory-batch-job-sub-flow">

        <logger level="INFO" doc:name="Log Job Start" message="Starting inventory batch job"/>

        <set-variable
            variableName="jobDate"
            doc:name="Set jobDate"
            value="#[if (isEmpty(p('scheduler.time'))) (now() as String {format: 'MM-dd-yyyy'}) else p('scheduler.time')]"/>

        <ee:transform doc:name="Initiate job variables">
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/java
---
p('file.errorHeaders')
                ]]></ee:set-payload>
            </ee:message>

            <ee:variables>
                <ee:set-variable variableName="traceId"><![CDATA[
%dw 2.0
output application/java
---
vars.traceId default correlationId
                ]]></ee:set-variable>

                <ee:set-variable variableName="inboundFileName"><![CDATA[
%dw 2.0
output application/java
---
vars.inputFileName default (p('SFTP.wmssftp.fileNamePattern') ++ vars.jobDate)
                ]]></ee:set-variable>

                <ee:set-variable variableName="inboundFilePath"><![CDATA[
%dw 2.0
output application/java
---
vars.inputFilePath default p('SFTP.wmssftp.path')
                ]]></ee:set-variable>

                <ee:set-variable variableName="errorFileName"><![CDATA[
%dw 2.0
output application/java
---
p('SFTP.errorsftp.path')
    ++ vars.jobDate
    ++ "/"
    ++ p('file.errorFile')
    ++ vars.jobDate
    ++ p('file.format')
                ]]></ee:set-variable>

                <ee:set-variable variableName="errorFolderName"><![CDATA[
%dw 2.0
output application/java
---
p('SFTP.errorsftp.path') ++ vars.jobDate
                ]]></ee:set-variable>
            </ee:variables>
        </ee:transform>

        <flow-ref name="create-error-daia-outbound-error-sftp-sub-flow" doc:name="Create Error File"/>

        <flow-ref name="read-inbound-sftp-sub-flow" doc:name="Read Inbound SFTP"/>

        <ee:transform doc:name="Enable Deferred JSON Payload">
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/json deferred=true
---
payload
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <flow-ref name="inventory-batch-processing-flow" doc:name="Process Inventory Batch"/>

        <logger level="INFO" doc:name="Log Job Completion" message="Inventory batch job processing completed"/>
    </sub-flow>

    <flow name="health-check-flow">
        <http:listener config-ref="HTTP_Listener_config" path="/health"
                       allowedMethods="GET" doc:name="Health Check GET"/>
        <ee:transform doc:name="Build Health Response">
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    status: "UP",
    application: app.name,
    timestamp: now()
}
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>

</mule>
