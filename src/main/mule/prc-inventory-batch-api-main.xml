<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd 
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
        http://www.mulesoft.org/schema/mule/core
        http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/ee/core
        http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
        http://www.mulesoft.org/schema/mule/http
        http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <!-- HTTP Listener for CloudHub 2.0 -->
    <http:listener-config
        name="HTTP_Listener_config"
        doc:name="HTTP Listener config">

        <http:listener-connection
            host="0.0.0.0"
            port="${http.port}"/>

    </http:listener-config>


    <!-- Daily scheduled execution -->
    <flow name="prc-inventory-batch-api-schedular-flow">

        <scheduler doc:name="Daily Scheduler">
            <scheduling-strategy>
                <fixed-frequency
                    frequency="1"
                    timeUnit="DAYS"/>
            </scheduling-strategy>
        </scheduler>

        <logger
            level="INFO"
            doc:name="Log Scheduled Start"
            message="Started scheduled inventory batch execution"/>

        <flow-ref
            name="inventory-batch-job-sub-flow"
            doc:name="Execute Inventory Batch Job"/>

        <logger
            level="INFO"
            doc:name="Log Scheduled Completion"
            message="Completed scheduled inventory batch execution"/>

        <error-handler ref="global-error-handlingError_Handler"/>

    </flow>


    <!-- Manual POST endpoint -->
    <flow name="manual-inventory-batch-trigger-flow">

        <http:listener
            config-ref="HTTP_Listener_config"
            path="/inventory/batch/run"
            allowedMethods="POST"
            doc:name="Manual Inventory Batch POST"/>

        <logger
            level="INFO"
            doc:name="Log Manual Trigger"
            message="Manual inventory batch execution requested"/>

        <flow-ref
            name="inventory-batch-job-sub-flow"
            doc:name="Execute Inventory Batch Job"/>

        <!-- Return a response after the job flow completes -->
        <ee:transform doc:name="Build Manual Trigger Response">
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/json
---
{
    message: "Inventory batch processing completed",
    traceId: vars.traceId
}
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <error-handler ref="global-error-handlingError_Handler"/>

    </flow>


    <!-- Shared job logic used by both entry points -->
    <sub-flow name="inventory-batch-job-sub-flow">

        <logger
            level="INFO"
            doc:name="Log Job Start"
            message="Starting inventory batch job"/>

        <set-variable
            variableName="jobDate"
            doc:name="Set jobDate"
            value="#[if (isEmpty(p('scheduler.time'))) (now() as String {format: 'MM-dd-yyyy'}) else p('scheduler.time')]"/>

        <ee:transform doc:name="Initiate job variables">

            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/java
---
p('file.errorHeaders')
                ]]></ee:set-payload>
            </ee:message>

            <ee:variables>

                <ee:set-variable variableName="traceId"><![CDATA[
%dw 2.0
output application/java
---
correlationId
                ]]></ee:set-variable>

                <ee:set-variable variableName="inboundFileName"><![CDATA[
%dw 2.0
output application/java
---
p('SFTP.wmssftp.fileNamePattern') ++ vars.jobDate
                ]]></ee:set-variable>

                <ee:set-variable variableName="errorFileName"><![CDATA[
%dw 2.0
output application/java
---
p('SFTP.errorsftp.path')
    ++ vars.jobDate
    ++ "/"
    ++ p('file.errorFile')
    ++ vars.jobDate
    ++ p('file.format')
                ]]></ee:set-variable>

                <ee:set-variable variableName="errorFolderName"><![CDATA[
%dw 2.0
output application/java
---
p('SFTP.errorsftp.path') ++ vars.jobDate
                ]]></ee:set-variable>

            </ee:variables>

        </ee:transform>

        <flow-ref
            name="create-error-daia-outbound-error-sftp-sub-flow"
            doc:name="Create Error File"/>

        <flow-ref
            name="read-inbound-sftp-sub-flow"
            doc:name="Read Inbound SFTP"/>

        <ee:transform doc:name="Enable Deferred JSON Payload">
            <ee:message>
                <ee:set-payload><![CDATA[
%dw 2.0
output application/json deferred=true
---
payload
                ]]></ee:set-payload>
            </ee:message>
        </ee:transform>

        <flow-ref
            name="inventory-batch-processing-flow"
            doc:name="Process Inventory Batch"/>

        <logger
            level="INFO"
            doc:name="Log Job Completion"
            message="Inventory batch job processing completed"/>

    </sub-flow>

</mule>
