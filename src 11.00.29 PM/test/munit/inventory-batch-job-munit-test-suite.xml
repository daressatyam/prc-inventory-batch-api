<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:munit="http://www.mulesoft.org/schema/mule/munit"
      xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
        http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="inventory-batch-job-munit-test-suite"/>

    <munit:test name="inventory-batch-job-sub-flow-success-test" description="Tests the shared inventory batch job orchestration">
        <munit:behavior>
            <munit-tools:mock-when processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="name" whereValue="create-error-daia-outbound-error-sftp-sub-flow"/>
                </munit-tools:with-attributes>
            </munit-tools:mock-when>

            <munit-tools:mock-when processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="name" whereValue="read-inbound-sftp-sub-flow"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value="#[output application/json --- [{SKU: 'SKU001', StoreId: 'STORE01', Type: 'Standard', Quantity: 10, Timestamp: '2026-10-27'}]]" mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>

            <munit-tools:mock-when processor="flow-ref">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="name" whereValue="inventory-batch-processing-flow"/>
                </munit-tools:with-attributes>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="inventory-batch-job-sub-flow"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:verify-call processor="flow-ref" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="name" whereValue="create-error-daia-outbound-error-sftp-sub-flow"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

            <munit-tools:verify-call processor="flow-ref" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="name" whereValue="read-inbound-sftp-sub-flow"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

            <munit-tools:verify-call processor="flow-ref" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="name" whereValue="inventory-batch-processing-flow"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>

            <munit-tools:assert-that expression="#[!isEmpty(vars.jobDate)]" is="#[MunitTools::equalTo(true)]" message="jobDate should be initialized"/>
            <munit-tools:assert-that expression="#[!isEmpty(vars.traceId)]" is="#[MunitTools::equalTo(true)]" message="traceId should be initialized"/>
            <munit-tools:assert-that expression="#[!isEmpty(vars.inboundFileName)]" is="#[MunitTools::equalTo(true)]" message="inboundFileName should be initialized"/>
        </munit:validation>
    </munit:test>

</mule>
